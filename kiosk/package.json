{
  "name": "infoklas-kiosk",
  "version": "1.4.0",
  "author": "school",
  "homepage": "https://example.org/infoklas",
  "description": "ІнфоКлас — кіоск-клієнт (Lockdown) для учнівських комп'ютерів",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux deb AppImage"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ua.school.infoklas.kiosk",
    "productName": "InfoKlas Kiosk",
    "files": [
      "main.js",
      "preload.js",
      "platform.js",
      "lock.html",
      "setup.html"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Education",
      "maintainer": "school",
      "executableName": "infoklas-kiosk"
    },
    "nsis": {
      "perMachine": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": null
  }
}